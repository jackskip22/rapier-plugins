      "name": "read",
      "title": "Read Rapier",
      "description": "Read exact text, matching lines (query), a block, heading or line range, history, versions, pending state or comparison. Continue next_cursor with cursor alone. after_revision with wait_ms waits for the person's next change.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "block": {
            "type": "string",
            "maxLength": 128
          },
          "heading": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                },
                "maxItems": 32
              }
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "query": {
            "type": "string",
            "maxLength": 2048
          },
          "versions": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "state": {
            "type": "boolean"
          },
          "history": {
            "type": "boolean"
          },
          "since": {
            "type": "string",
            "maxLength": 256
          },
          "comparison": {
            "type": "boolean"
          },
          "return_id": {
            "type": "string",
            "maxLength": 128
          },
          "after_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "With wait_ms: return when the revision passes this."
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "description": "Bounded wait (ms) for the next human revision."
          },
          "document": {
            "type": "string",
            "maxLength": 256
          },
          "agent": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "required": [
          "document"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
