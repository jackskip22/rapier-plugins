      "name": "open",
      "title": "Open Rapier",
      "description": "Create a Markdown document (text and filename), resume one (document), open a Note, import an authorized file, or open a Rapier document link (url). Returns revision and the whole text when it fits, otherwise a document map. Share editor_url; keep document private.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "text": {
            "type": "string",
            "maxLength": 67108864
          },
          "filename": {
            "type": "string",
            "maxLength": 256
          },
          "note": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "file": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "resourceUri": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "name",
              "resourceUri"
            ],
            "additionalProperties": false
          },
          "createToken": {
            "type": "string",
            "maxLength": 128
          },
          "document": {
            "type": "string",
            "maxLength": 256
          },
          "agent": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
