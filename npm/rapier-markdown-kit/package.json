{
  "name": "rapier-markdown-kit",
  "version": "1.1.55",
  "description": "Read, write and style Self-contained Markdown: the universal stylesheet, picture layout, text marks, picture appendix, line planner and Will/1 markers. MIT, no dependencies.",
  "keywords": [
    "markdown",
    "self-contained",
    "commonmark",
    "gfm",
    "stylesheet",
    "css",
    "layout",
    "text-layout",
    "text-wrap",
    "line-breaking",
    "images",
    "document",
    "will",
    "agent",
    "conformance",
    "rapier"
  ],
  "author": "Jack Skipworth",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./style.css"
  ],
  "dependencies": {},
  "files": [
    "dist",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/kit/index.mjs",
  "exports": {
    ".": "./dist/kit/index.mjs",
    "./layout": "./dist/kit/layout.mjs",
    "./marks": "./dist/kit/marks.mjs",
    "./model": "./dist/kit/model.mjs",
    "./will": "./dist/kit/will.mjs",
    "./assets": "./dist/kit/assets.mjs",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-plugins.git",
    "directory": "npm/rapier-markdown-kit"
  }
}
