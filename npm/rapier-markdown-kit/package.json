{
  "name": "rapier-markdown-kit",
  "version": "1.1.1",
  "description": "Read and write Rapier Markdown without the editor: picture layout, text marks, the line planner, Will markers and the picture appendix. MIT, no dependencies.",
  "author": "Jack Skipworth",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {},
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/kit/index.mjs",
  "exports": {
    ".": "./dist/kit/index.mjs",
    "./layout": "./dist/kit/layout.mjs",
    "./marks": "./dist/kit/marks.mjs",
    "./model": "./dist/kit/model.mjs",
    "./will": "./dist/kit/will.mjs",
    "./assets": "./dist/kit/assets.mjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-plugins.git",
    "directory": "npm/rapier-markdown-kit"
  }
}
