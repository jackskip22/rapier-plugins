{
  "name": "rapier-embed",
  "version": "1.1.81",
  "description": "Put a Markdown document editor in your web app as an iframe or an exact Markdown form field, saving to your own storage; agent review events carry no source. Session settings and optional host-stored pictures. MIT, no dependencies.",
  "keywords": [
    "markdown",
    "editor",
    "markdown-editor",
    "embed",
    "iframe",
    "form-field",
    "web-component",
    "custom-element",
    "document",
    "offline",
    "self-hosted",
    "agent",
    "webmcp",
    "review",
    "rapier"
  ],
  "author": "Jack Skipworth",
  "license": "MIT",
  "homepage": "https://rapier.website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-plugins.git",
    "directory": "npm/rapier-embed"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./embed.mjs"
  },
  "files": [
    "embed.mjs",
    "contract.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
