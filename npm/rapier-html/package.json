{
  "name": "rapier-html",
  "version": "1.1.94",
  "description": "One command turns a Markdown file into one offline HTML file: the whole Rapier editor with the document inside. Opens in any browser, phone or desktop, with no install or account. Write, draw and paint watercolor, then Send back the edits to your AI agent.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "single-file",
    "html",
    "offline-first",
    "local-first",
    "mobile-first",
    "cli",
    "ai-agents",
    "mcp",
    "claude",
    "chatgpt",
    "llm",
    "send-back",
    "review",
    "diff",
    "svg-editor",
    "drawing",
    "watercolor",
    "mermaid",
    "rapier"
  ],
  "author": "Jack Skipworth",
  "license": "AGPL-3.0-only",
  "homepage": "https://rapier.website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-plugins.git",
    "directory": "npm/rapier-html"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rapier-html": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/page.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "BUILD.json"
  ],
  "sideEffects": false
}
